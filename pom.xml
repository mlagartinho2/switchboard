<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.llizzard</groupId>
    <artifactId>switchboard-parent</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>

    <name>Switchboard Parent</name>
    <description>
        Parent build for the Switchboard use-case dispatch library: shared version, Spring Boot BOM
        import, and build settings for the autoconfigure module, the starter, and the sample.
    </description>

    <modules>
        <module>switchboard-autoconfigure</module>
        <module>switchboard-spring-boot-starter</module>
        <module>switchboard-sample</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Latest GA Spring Boot 4.x on Maven Central at implementation time (Principle VII: no M/RC). -->
        <spring-boot.version>4.1.2</spring-boot.version>

        <!-- Only the sample is runnable: lets "mvn -pl switchboard-sample -am spring-boot:run" skip the
             parent and library modules, which have no main class. The sample sets this to false. -->
        <spring-boot.run.skip>true</spring-boot.run.skip>

        <!-- Plugin versions aligned with spring-boot-dependencies ${spring-boot.version}.
             A BOM import does not carry pluginManagement, so they are pinned here. -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>

        <!-- TODO(NEXUS_URL): replace with the internal Nexus maven-releases URL before the first
             release (research.md §R13). Can also be supplied with -Dswitchboard.nexus.url=... -->
        <switchboard.nexus.url>https://nexus.invalid/repository/maven-releases/</switchboard.nexus.url>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.llizzard</groupId>
                <artifactId>switchboard-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.llizzard</groupId>
                <artifactId>switchboard-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Surefire 3.x detects the JUnit Platform from the test classpath and runs
                 JUnit Jupiter tests with no extra provider configuration. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>internal-releases</id>
            <name>Internal Nexus releases</name>
            <!-- TODO(NEXUS_URL): see the switchboard.nexus.url property above. -->
            <url>${switchboard.nexus.url}</url>
        </repository>
    </distributionManagement>
</project>
